# Django Settings
SECRET_KEY=django-insecure-quotation-invoice-system-super-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# For local PostgreSQL:
DB_ENGINE=django.db.backends.postgresql
DB_NAME=invoice_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Or use full DATABASE_URL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL=postgresql://user:password@localhost:5432/invoice_db

# Fallback to SQLite if PostgreSQL server is not active:
USE_SQLITE_FALLBACK=True

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=1440
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
